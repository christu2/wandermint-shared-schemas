{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wandermint.com/schemas/recommendation.schema.json",
  "title": "TripRecommendation",
  "description": "Trip recommendation sent from Admin dashboard or Backend to iOS app",
  "type": "object",
  "required": [
    "id",
    "tripOverview",
    "destinations",
    "logistics",
    "totalCost"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique recommendation identifier"
    },
    "tripOverview": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "description": "Overall trip summary and highlights"
    },
    "costNotes": {
      "type": "string",
      "maxLength": 10000,
      "description": "Points transfer strategies, redemption instructions, and overall cost notes"
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "id",
          "cityName",
          "arrivalDate",
          "departureDate",
          "numberOfNights"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "cityName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "arrivalDate": {
            "$ref": "common-types.schema.json#/$defs/ISODate"
          },
          "departureDate": {
            "$ref": "common-types.schema.json#/$defs/ISODate"
          },
          "numberOfNights": {
            "type": "integer",
            "minimum": 0,
            "maximum": 90
          },
          "overview": {
            "type": "string",
            "maxLength": 5000
          },
          "alternativeDates": {
            "type": "string",
            "maxLength": 500
          },
          "accommodationOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "priority", "hotel"],
              "properties": {
                "id": {"type": "string"},
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "bookingInstructions": {
                  "type": "string",
                  "maxLength": 5000
                },
                "selectedOption": {
                  "type": "boolean"
                },
                "recommendedReason": {
                  "type": "string",
                  "maxLength": 2000
                },
                "totalCost": {
                  "type": "object",
                  "properties": {
                    "paymentType": {"type": "string"},
                    "cashAmount": {"type": "number", "minimum": 0},
                    "totalCashValue": {"type": "number", "minimum": 0},
                    "pointsAmount": {"type": "number", "minimum": 0},
                    "pointsProgram": {"type": "string"},
                    "notes": {"type": "string"}
                  }
                },
                "hotel": {
                  "type": "object",
                  "required": ["name", "location"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "rating": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 5
                    },
                    "pricePerNight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "pointsPerNight": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "loyaltyProgram": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "location": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "bookingUrl": {
                      "$ref": "common-types.schema.json#/$defs/OptionalURL"
                    },
                    "bookingInstructions": {
                      "type": "string",
                      "maxLength": 5000
                    },
                    "detailedDescription": {
                      "type": "string",
                      "maxLength": 5000
                    },
                    "amenities": {
                      "type": "array",
                      "items": {"type": "string"}
                    },
                    "cancellationPolicy": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "contactInfo": {
                      "type": "string",
                      "maxLength": 500
                    },
                    "photoUrl": {
                      "$ref": "common-types.schema.json#/$defs/OptionalURL"
                    },
                    "photos": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "tripadvisorId": {
                      "type": "string",
                      "maxLength": 100
                    },
                    "tripadvisorUrl": {
                      "$ref": "common-types.schema.json#/$defs/OptionalURL"
                    }
                  }
                }
              }
            }
          },
          "recommendedActivities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {"type": "string"},
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                },
                "location": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "address": {"type": "string"}
                      }
                    }
                  ]
                },
                "estimatedCost": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    {
                      "type": "object",
                      "properties": {
                        "paymentType": {"type": "string"},
                        "cashAmount": {"type": "number", "minimum": 0},
                        "pointsAmount": {"type": "number", "minimum": 0},
                        "pointsProgram": {"type": "string"}
                      }
                    }
                  ]
                },
                "estimatedDuration": {
                  "type": "string",
                  "maxLength": 100
                },
                "category": {
                  "type": "string",
                  "maxLength": 100
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "bestTimeToVisit": {
                  "type": "string",
                  "maxLength": 200
                },
                "bookingRequired": {
                  "type": "boolean"
                },
                "bookingInstructions": {
                  "type": "string",
                  "maxLength": 2000
                },
                "tips": {
                  "type": "string",
                  "maxLength": 2000
                },
                "website": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "yelpUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "tripadvisorUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "bookingUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                }
              }
            }
          },
          "recommendedRestaurants": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": {"type": "string"},
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "cuisine": {
                  "type": "string",
                  "maxLength": 100
                },
                "mealType": {
                  "type": "string",
                  "maxLength": 50
                },
                "priority": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                },
                "location": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 500
                    },
                    {
                      "type": "object",
                      "properties": {
                        "name": {"type": "string"},
                        "address": {"type": "string"}
                      }
                    }
                  ]
                },
                "priceRange": {
                  "type": "string",
                  "enum": ["$", "$$", "$$$", "$$$$", ""]
                },
                "estimatedCost": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "object",
                      "properties": {
                        "paymentType": {"type": "string"},
                        "cashAmount": {"type": "number", "minimum": 0}
                      }
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "maxLength": 2000
                },
                "reservationRequired": {
                  "type": "boolean"
                },
                "reservationUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "reservationInstructions": {
                  "type": "string",
                  "maxLength": 2000
                },
                "specialties": {
                  "type": "string",
                  "maxLength": 1000
                },
                "tips": {
                  "type": "string",
                  "maxLength": 2000
                },
                "yelpUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "tripadvisorUrl": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                },
                "website": {
                  "$ref": "common-types.schema.json#/$defs/OptionalURL"
                }
              }
            }
          }
        }
      }
    },
    "logistics": {
      "type": "object",
      "required": ["transportSegments"],
      "properties": {
        "transportSegments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"type": "string"},
              "fromCity": {"type": "string"},
              "toCity": {"type": "string"},
              "departureDate": {"type": "string"},
              "dateRange": {"type": "string"},
              "segmentType": {"type": "string"},
              "notes": {"type": "string"},
              "recommendedOption": {"type": "string"},
              "transportOptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {"type": "string"},
                    "transportType": {"type": "string", "enum": ["flight", "train", "bus", "ferry", "car", "car_rental"]},
                    "type": {"type": "string", "enum": ["flight", "train", "bus", "ferry", "car", "car_rental"]},
                    "priority": {"type": "integer", "minimum": 1, "maximum": 10},
                    "duration": {"type": "string"},
                    "bookingReference": {"type": "string"},
                    "bookingUrl": {"$ref": "common-types.schema.json#/$defs/OptionalURL"},
                    "notes": {"type": "string"},
                    "isRoundTrip": {"type": "boolean"},
                    "linkedSegmentId": {"type": "string"},
                    "recommendedSelection": {"type": "boolean"},
                    "cost": {
                      "anyOf": [
                        {"type": "number", "minimum": 0},
                        {
                          "type": "object",
                          "properties": {
                            "paymentType": {"type": "string"},
                            "cashAmount": {"type": "number", "minimum": 0},
                            "totalCashValue": {"type": "number", "minimum": 0},
                            "pointsAmount": {"type": "number", "minimum": 0},
                            "pointsProgram": {"type": "string"},
                            "notes": {"type": "string"}
                          }
                        }
                      ]
                    },
                    "details": {
                      "type": "object",
                      "properties": {
                        "flightNumber": {"type": "string"},
                        "airline": {"type": "string"},
                        "departureAirportName": {"type": "string"},
                        "arrivalAirportName": {"type": "string"},
                        "class": {"type": "string"},
                        "aircraft": {"type": "string"},
                        "operator": {"type": "string"},
                        "trainNumber": {"type": "string"},
                        "departureStation": {"type": "string"},
                        "arrivalStation": {"type": "string"},
                        "departureTerminal": {"type": "string"},
                        "arrivalTerminal": {"type": "string"},
                        "departureTime": {"type": "string"},
                        "arrivalTime": {"type": "string"},
                        "company": {"type": "string"},
                        "pickupLocation": {"type": "string"},
                        "dropoffLocation": {"type": "string"},
                        "details": {
                          "type": "object",
                          "properties": {
                            "departure": {
                              "type": "object",
                              "properties": {
                                "airportCode": {"type": "string"},
                                "time": {"type": "string"},
                                "date": {"type": "string"}
                              }
                            },
                            "arrival": {
                              "type": "object",
                              "properties": {
                                "airportCode": {"type": "string"},
                                "time": {"type": "string"},
                                "date": {"type": "string"}
                              }
                            },
                            "route": {"type": "string"},
                            "showDateChange": {"type": "string"},
                            "layovers": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "airportCode": {"type": "string"},
                                  "airportName": {"type": "string"},
                                  "duration": {"type": "string"},
                                  "flightNumber": {"type": "string"},
                                  "airline": {"type": "string"}
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "bookingDeadlines": {
          "type": "array",
          "items": {"type": "object"}
        },
        "generalInstructions": {
          "type": "string",
          "maxLength": 5000
        }
      }
    },
    "totalCost": {
      "type": "object",
      "required": ["totalEstimate", "flights", "accommodation", "activities", "food", "localTransport", "miscellaneous", "currency"],
      "properties": {
        "totalEstimate": {
          "type": "number",
          "minimum": 0
        },
        "flights": {
          "type": "number",
          "minimum": 0
        },
        "accommodation": {
          "type": "number",
          "minimum": 0
        },
        "activities": {
          "type": "number",
          "minimum": 0
        },
        "food": {
          "type": "number",
          "minimum": 0
        },
        "localTransport": {
          "type": "number",
          "minimum": 0
        },
        "miscellaneous": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "common-types.schema.json#/$defs/CurrencyCode"
        },
        "pointsUsed": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "bookingLinks": {
      "type": "object",
      "properties": {
        "flights": {
          "$ref": "common-types.schema.json#/$defs/OptionalURL"
        },
        "hotels": {
          "type": "array",
          "items": {
            "$ref": "common-types.schema.json#/$defs/OptionalURL"
          }
        }
      }
    },
    "specialNotes": {
      "type": "string",
      "maxLength": 2000
    },
    "_schemaVersion": {
      "type": "string",
      "description": "Schema version for tracking compatibility",
      "examples": ["2.1.0"]
    },
    "_lastModifiedBy": {
      "type": "string",
      "description": "Component that last modified this recommendation",
      "examples": ["admin_dashboard", "ios_app", "ai_copilot"]
    }
  },
  "version": "2.1.0",
  "lastUpdated": "2026-11-11",
  "changelog": [
    {
      "version": "2.1.0",
      "date": "2026-11-11",
      "changes": [
        "Aligned recommendation schema with full AdminDestinationBasedRecommendation structure",
        "Added costNotes, pointsUsed, transportType, nested flight/train/car details, and cash/points cost objects",
        "Added rich hotel, activity, and restaurant fields (bookingInstructions, tips, mealType, specialties, OptionalURL)"
      ],
      "breaking": false
    },
    {
      "version": "2.0.0",
      "date": "2026-05-03",
      "changes": [
        "BREAKING: Added logistics as required field at root level",
        "BREAKING: Updated totalCost required fields to include all cost categories"
      ],
      "breaking": true
    }
  ]
}
